{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Cloudflare hosting (Nov 1, 2026; see docs/cloudflare-move.md). An
  // assets-only Worker: every page is a prebuilt file in ./dist, uploaded by
  // .github/workflows/deploy-cloudflare.yml.
  "name": "realpropertyplanning",
  "compatibility_date": "2026-10-01",
  // Runs only for /.well-known/* (run_worker_first): turns the SPA fallback's
  // homepage HTML into a 404 there. See worker/index.js.
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/.well-known/*"],
    // Pages are built as /executors/index.html but their address (and canonical)
    // is /executors: serve them without a trailing slash, and send /executors/
    // to /executors. The default (auto-trailing-slash) would do the opposite.
    "html_handling": "drop-trailing-slash",
    // Addresses with no file get the app shell, which loads route-meta.js and
    // renders the page in the browser (same behaviour as on Lovable today).
    "not_found_handling": "single-page-application"
  }
}
